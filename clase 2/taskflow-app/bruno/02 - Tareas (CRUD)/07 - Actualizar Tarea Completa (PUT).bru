meta {
  name: 07 - Actualizar Tarea Completa (PUT)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/api/tasks/1
  body: json
  auth: none
}

body:json {
  {
    "title": "Configurar contenedor PostgreSQL (Modificado por Bruno)",
    "description": "Se ha actualizado exitosamente la descripción mediante petición HTTP PUT.",
    "category_id": 3,
    "priority": "alta",
    "status": "completada"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.id: eq 1
}
